{
  "version": 2,
  "buildCommand": "npm run build:client",
  "outputDirectory": "client/dist",
  "routes": [
    {
      "src": "/api/airports",
      "dest": "/api/airports.js"
    },
    {
      "src": "/api/parking/search",
      "dest": "/api/parking/search.js"
    },
    {
      "src": "/api/transfers/quote",
      "dest": "/api/transfers/quote.js"
    },
    {
      "src": "/api/bookings",
      "dest": "/api/bookings.js"
    },
    {
      "src": "/api/send-voucher",
      "dest": "/api/send-voucher.js"
    },
    {
      "src": "/api/admin/lots/(.*)",
      "dest": "/api/admin/lots.js?id=$1"
    },
    {
      "src": "/api/admin/lots",
      "dest": "/api/admin/lots.js"
    },
    {
      "src": "/api/admin/bookings/(.*)",
      "dest": "/api/admin/bookings.js?id=$1"
    },
    {
      "src": "/api/admin/bookings",
      "dest": "/api/admin/bookings.js"
    },
    {
      "src": "/api/admin/metrics",
      "dest": "/api/admin/metrics.js"
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
